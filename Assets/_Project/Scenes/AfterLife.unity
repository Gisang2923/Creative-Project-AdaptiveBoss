--- !u!114 &677738022
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 677738021}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d5e5ff27004603b4bbe28327e07b7006, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AfterlifeNPC
  dialogueController: {fileID: 1594696788}
  growthUI: {fileID: 1594696789}
  returnAttemptController: {fileID: 886816205}
  actionMenu: {fileID: 737787492}
  speakerName: ???
  firstDialogueLines:
  - "\uB208\uC744 \uB5B4\uAD70."
  - "\uB180\uB784 \uAC83 \uC5C6\uB124. \uC774\uACF3\uC740 \uB2E4\uC2DC \uB098\uC544\uAC00\uAE30
    \uC804 \uC7A0\uC2DC \uBA38\uBB34\uB294 \uACF3\uC77C\uC138."
  - "\uB098\uB294 \uC774\uACF3\uC5D0 \uC628 \uC790\uAC00 \uB2E4\uC2DC \uB098\uC544\uAC08
    \uC218 \uC788\uB3C4\uB85D \uB3D5\uACE0 \uC788\uC9C0."
  - "\uC900\uBE44\uAC00 \uB418\uBA74 \uB9D0\uD558\uAC8C."
  act1RecoveryDialogueLines:
  - "\uB2E4\uC2DC \uB3CC\uC544\uC654\uAD70."
  - "\uC544\uC9C1 \uB05D\uB09C \uAC83\uC740 \uC544\uB2CC \uBAA8\uC591\uC774\uB124."
  - "\uC900\uBE44\uAC00 \uB418\uBA74 \uB2E4\uC2DC \uAC00\uAC8C."
  act1RecoveryDialogueByStage: []
  farewellDialogueLines:
  - "\uC900\uBE44\uAC00 \uB410\uB2E4\uBA74 \uB2E4\uC2DC \uAC00\uAC8C."
  - "\uC774\uBC88\uC5D0\uB294 \uC870\uAE08 \uB354 \uB098\uC544\uAC08 \uC218 \uC788\uACA0\uC9C0."
  maxStatsLines:
  - "\uC9C0\uAE08 \uC790\uB124\uC5D0\uAC8C \uB354 \uBCF4\uD0E4 \uAC83\uC740 \uC5C6\uAD70."
  playerSpeakerName: "\uB098"
  clearPlayerLines:
  - "\uC65C\u2026 \uB2E4\uC2DC \uC5EC\uAE30\uB85C \uC628 \uAC70\uC8E0?"
  - "\uBD84\uBA85 \uADF8 \uC0AC\uB78C\uC744 \uC4F0\uB7EC\uB728\uB838\uB294\uB370."
  clearNpcLines:
  - "\u2026\u2026\uC774\uC0C1\uD558\uAD70."
  - "\uC6D0\uB798\uB77C\uBA74 \uC790\uB124\uAC00 \uB2E4\uC2DC \uC774\uACF3\uC5D0
    \uC62C \uC774\uC720\uB294 \uC5C6\uB124."
  - "\uC7A0\uC2DC \uC788\uC5B4\uBCF4\uAC8C. \uB2E4\uC2DC \uB3CC\uB824\uBCF4\uB0BC
    \uC218 \uC788\uB294\uC9C0 \uD655\uC778\uD574\uBCF4\uC9C0."
  returnFailedLines:
  - "\u2026\u2026\uC548 \uB418\uB294\uAD70."
  - "\uB3CC\uC544\uAC08 \uAE38\uC740 \uB0A8\uC544 \uC788\uC5B4."
  - "\uB2E4\uB9CC \uC790\uB124\uAC00 \uD5A5\uD574\uC57C \uD560 \uACF3\uC774 \uB2EC\uB77C\uC9C4
    \uBAA8\uC591\uC774\uAD70."
  - "\uC774\uC720\uB294 \uB098\uB3C4 \uBAA8\uB974\uACA0\uB124."
  - "\uB2E4\uC2DC \uAC00\uBCF4\uAC8C. \uADF8\uACF3\uC5D0\uC11C \uD655\uC778\uD558\uB294
    \uC218\uBC16\uC5D0 \uC5C6\uACA0\uC5B4."
  act2DiscoveryPlayerLines:
  - "\uC800 \uC0AC\uB78C\u2026 \uC774\uC0C1\uD574\uC694."
  - "\uAC19\uC740 \uC0AC\uB78C\uC744 \uC0C1\uB300\uD558\uACE0 \uC788\uB294\uB370,
    \uC2F8\uC6B8\uC218\uB85D \uC870\uAE08\uC529 \uC774\uC9C8\uAC10\uC774 \uB4E4\uC5B4\uC694."
  act2DiscoveryNpcLines:
  - "\uC774\uC9C8\uAC10\uC774\uB77C\u2026"
  - "\uC800\uC790\uB294 \uC6D0\uB798 \uADF8\uB7F0 \uC2DD\uC73C\uB85C \uB2EC\uB77C\uC9C0\uB294
    \uC874\uC7AC\uAC00 \uC544\uB2C8\uB124."
  - "\uC2F8\uC6C0\uC758 \uBC29\uC2DD\uC5D0\uB294 \uC815\uD574\uC9C4 \uACB0\uC774
    \uC788\uC5B4. \uBA87 \uBC88\uC744 \uB2E4\uC2DC \uB9C8\uC8FC\uD574\uB3C4 \uADF8
    \uD2C0\uC744 \uC27D\uAC8C \uBC97\uC5B4\uB098\uC9C0\uB294 \uC54A\uC9C0."
  - "\uC790\uB124\uAC00 \uB290\uB080 \uAC83\uC774 \uB2E8\uC21C\uD55C \uCC29\uAC01\uC778\uC9C0,
    \uC544\uB2C8\uBA74 \uC815\uB9D0 \uC800\uCABD\uC774 \uB2EC\uB77C\uC9C0\uACE0 \uC788\uB294
    \uAC74\uC9C0\u2026"
  - "\uD55C \uBC88 \uB354 \uD655\uC778\uD574\uBCF4\uAC8C."
  act2TruthNpcIntroLines:
  - "\uC774\uBC88\uC5D0\uB3C4 \uAC19\uC740 \uC774\uC9C8\uAC10\uC774 \uC788\uC5C8\uB098?"
  act2TruthPlayerLines:
  - "\uB124."
  - "\uCC98\uC74C\uC5D0\uB294 \uCC29\uAC01\uD55C \uC904 \uC54C\uC558\uB294\uB370\u2026
    \uC544\uB2CC \uAC83 \uAC19\uC544\uC694."
  act2TruthNpcConclusionLines:
  - "\u2026\u2026\uADF8\uB807\uB2E4\uBA74 \uC774\uC0C1\uD558\uAD70."
  - "\uC800\uC790\uB294 \uC2F8\uC6B8\uC218\uB85D \uB2EC\uB77C\uC9C0\uACE0 \uC788\uC5B4."
  - "\uADF8\uB7F0 \uC77C\uC740 \uC6D0\uB798 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uB124."
  act2TruthPlayerQuestionLines:
  - "\uADF8\uB7FC \uC5B4\uB5BB\uAC8C \uD574\uC57C \uD558\uC8E0?"
  act2TruthNpcAdviceLines:
  - "\uC6D0\uC778\uC740 \uB098\uB3C4 \uBAA8\uB974\uACA0\uB124."
  - "\uB2E4\uB9CC \uC0C1\uB300\uAC00 \uB2EC\uB77C\uC9C0\uACE0 \uC788\uB2E4\uBA74,
    \uC790\uB124\uB3C4 \uAC19\uC740 \uBC29\uC2DD\uB9CC \uACE0\uC9D1\uD574\uC11C\uB294
    \uC548 \uB418\uACA0\uC9C0."
  - "\uC774\uBC88\uC5D0\uB294 \uC790\uB124 \uCABD\uC5D0\uC11C\uB3C4 \uBCC0\uD654\uB97C
    \uC918\uBCF4\uAC8C."
  act2NormalDefeatLines:
  - "\uB610 \uB3CC\uC544\uC654\uAD70."
  - "\uC11C\uB450\uB974\uC9C0 \uB9D0\uAC8C."
  - "\uC774\uBC88\uC5D0\uB294 \uC870\uAE08 \uB354 \uBCF4\uACE0 \uC6C0\uC9C1\uC5EC\uBCF4\uAC8C."
  act2RepeatDefeatLines:
  - "\uB610 \uB3CC\uC544\uC654\uAD70."
  - "\uC0C1\uB300\uAC00 \uB2EC\uB77C\uC9C4\uB2E4\uBA74 \uC790\uB124\uB3C4 \uB2EC\uB77C\uC838\uC57C
    \uD558\uB124."
  - "\uAC19\uC740 \uB2F5\uB9CC \uACE0\uC9D1\uD558\uC9C0 \uB9D0\uAC8C."
  interactPrompt: {fileID: 614930918}
