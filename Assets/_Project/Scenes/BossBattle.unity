  m_Script: {fileID: 11500000, guid: 7a8c0ed759b9a2c47a97d0d7ab1d7f9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FinalEndingPresentationController
  bossAnimator: {fileID: 402595765}
  adaptivePresentation: {fileID: 208444662}
  playerMovement: {fileID: 800044310}
  playerInput: {fileID: 800044311}
  battleBgmSource: {fileID: 0}
  dialogueController: {fileID: 0}
  finalKneelDelay: 0.2
  finalDialogueBeats:
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uB9C8\uCE68\uB0B4\u2026"
    pauseBefore: 0
    pauseAfter: 1
  - speakerName: "\uB098"
    lines:
    - "\u2026\uBB50\uAC00 \uB9D0\uC774\uC9C0?"
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uB05D\uAE4C\uC9C0 \uC654\uAD70."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\uB05D?"
    - "\uB2F9\uC2E0\uC744 \uC4F0\uB7EC\uB728\uB9AC\uBA74 \uB05D\uB098\uB294 \uAC70
      \uC544\uB2CC\uAC00."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uB098\uB3C4 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD588\uC5B4."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\u2026\uBB34\uC2A8 \uB73B\uC774\uC9C0?"
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uB098\uB3C4 \uC790\uB124\uC640 \uAC19\uC558\uC73C\uB2C8\uAE4C."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\uB098\uC640 \uAC19\uC558\uB2E4\uACE0?"
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uC774\uACF3\uC5D0 \uB3C4\uCC29\uD588\uACE0."
    - "\uB05D\uC5D0 \uC788\uB294 \uC790\uC640 \uC2F8\uC6E0\uC9C0."
    - "\uC8FD\uACE0."
    - "\uB3CC\uC544\uC624\uACE0."
    - "\uB610 \uC2F8\uC6E0\uC5B4."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\u2026\uB2F9\uC2E0\uB3C4 \uB3C4\uC804\uC790\uC600\uB2E4\uB294 \uAC74\uAC00?"
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uADF8\uB798."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\uADF8\uB7FC \uB2F9\uC2E0\uC774 \uC4F0\uB7EC\uB728\uB9B0 \uC790\uB294?"
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uC9C0\uAE08\uC758 \uB098\uC640 \uAC19\uC740 \uC0AC\uB78C\uC774\uC5C8\uC9C0."
    - "\uC544\uB9C8 \uADF8 \uC0AC\uB78C \uC804\uC5D0\uB3C4 \uB204\uAD70\uAC00 \uC788\uC5C8\uC744
      \uAC70\uB2E4."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\uADF8\uB807\uB2E4\uBA74\u2026"
    - "\uB0B4 \uC6C0\uC9C1\uC784\uC744 \uC54C\uACE0 \uC788\uC5C8\uB358 \uAC83\uB3C4
      \uADF8 \uB54C\uBB38\uC778\uAC00?"
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uADF8\uAC74 \uC790\uB124 \uB54C\uBB38\uC774\uC9C0."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\uB098?"
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uC8FD\uC5B4\uC11C \uB3CC\uC544\uC62C \uB54C\uB9C8\uB2E4."
    - "\uBAA8\uB4E0 \uAC83\uC774 \uC790\uB124\uC640 \uD568\uAED8 \uB3CC\uC544\uAC14\uB2E4\uACE0
      \uC0DD\uAC01\uD588\uB098?"
    - "\uC544\uB2C8."
    - "\uB098\uB97C \uB05D\uB0B4\uACA0\uB2E4\uB294 \uC758\uC9C0."
    - "\uB2E4\uC2DC \uC77C\uC5B4\uC11C\uAC8C \uD55C \uADF8 \uC758\uC9C0\uB294 \uC790\uB124\uC5D0\uAC8C
      \uB3CC\uC544\uAC14\uB2E4."
    - "\uD558\uC9C0\uB9CC \uC790\uB124\uAC00 \uC5B4\uB5BB\uAC8C \uC2F8\uC6E0\uB294\uC9C0\uB294\u2026"
    - "\uC774\uACF3\uC5D0 \uB0A8\uC558\uC5B4."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\uADF8\uB798\uC11C \uB0B4 \uACF5\uACA9\uC744\u2026"
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uC790\uB124\uAC00 \uB098\uB97C \uBC30\uC6B4 \uB9CC\uD07C."
    - "\uB098\uB3C4 \uC790\uB124\uB97C \uBC30\uC6E0\uB2E4."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\uADF8\uB7FC \uB098\uB97C \uACC4\uC18D \uC774\uACF3\uC73C\uB85C \uB3CC\uB824\uBCF4\uB0B4
      \uC900 \uC0AC\uB78C\uC740?"
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\u2026\uC544\uC9C1 \uADF8\uACF3\uC5D0 \uC788\uB098."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\uC54C\uACE0 \uC788\uB294 \uC0AC\uB78C\uC774\uC57C?"
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uC624\uB798\uC804\uC5D0 \uB098\uC640 \uC2F8\uC6E0\uB358 \uC0AC\uB78C\uC774\uC9C0."
    - "\uBA87 \uBC88\uC744 \uC4F0\uB7EC\uB728\uB838\uB294\uC9C0\uB294 \uAE30\uC5B5\uB098\uC9C0
      \uC54A\uC544."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\uADF8\uB7F0\uB370 \uC65C \uC9C0\uAE08\uC740 \uB3CC\uC544\uC624\uC9C0 \uBABB\uD558\uC9C0?"
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uB108\uBB34 \uB9CE\uC774 \uB0A8\uACBC\uC73C\uB2C8\uAE4C."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\u2026\uBB58?"
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uC790\uAE30 \uC790\uC2E0\uC744."
    - "\uC8FD\uC744 \uB54C\uB9C8\uB2E4 \uC2F8\uC6C0\uC758 \uD754\uC801\uB9CC \uC774\uACF3\uC5D0
      \uB0A8\uB294 \uAC74 \uC544\uB2C8\uC57C."
    - "\uB3CC\uC544\uC624\uB294 \uCABD\uC5D0\uC11C\uB3C4 \uC870\uAE08\uC529 \uC783\uB294\uB2E4."
    - "\uCC98\uC74C\uC5D0\uB294 \uC774\uB984\uC744 \uC78A\uACE0."
    - "\uADF8\uB2E4\uC74C\uC5D0\uB294 \uC65C \uC2F8\uC6B0\uACE0 \uC788\uC5C8\uB294\uC9C0\uB97C
      \uC78A\uC9C0."
    - "\uADF8\uB798\uB3C4 \uB9F9\uC138\uB97C \uAE30\uC5B5\uD558\uB294 \uB3D9\uC548\uC5D0\uB294
      \uB2E4\uC2DC \uB3CC\uC544\uC628\uB2E4."
    - "\uD558\uC9C0\uB9CC \uC8FD\uC74C\uC744 \uBC18\uBCF5\uD558\uB2E4 \uBCF4\uBA74
      \uADF8 \uB9F9\uC138\uB9C8\uC800 \uB2F3\uC544\uAC00\uC9C0."
    - "\uC804\uC7A5\uC73C\uB85C \uB3CC\uC544\uAC08 \uB9CC\uD07C\uC758 \uC774\uC720\uB294
      \uC783\uC5C8\uC9C0\uB9CC."
    - "\uC644\uC804\uD788 \uB193\uC544\uBC84\uB9AC\uC9C0\uB3C4 \uBABB\uD55C \uC790\uB294\u2026
      \uADF8\uACF3\uC5D0 \uB0A8\uAC8C \uB41C\uB2E4."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\uB9F9\uC138?"
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uB05D\uC744 \uBCF4\uACA0\uB2E4\uB294 \uAC83."
    - "\uC4F0\uB7EC\uC838\uB3C4 \uB2E4\uC2DC \uC774\uACF3\uC5D0 \uC624\uACA0\uB2E4\uB294
      \uAC83."
    - "\uADF8\uAC8C \uBB34\uC5C7\uC774\uB4E0 \uC0C1\uAD00\uC5C6\uC5B4."
    - "\uC790\uB124\uB294 \uC8FD\uC5C8\uB294\uB370\uB3C4 \uB2E4\uC2DC \uC654\uC5B4."
    - "\uB610 \uC8FD\uC5C8\uB294\uB370\uB3C4 \uB3CC\uC544\uC654\uACE0."
    - "\uB204\uAC00 \uAC15\uC694\uD55C \uAC83\uB3C4 \uC544\uB2CC\uB370 \uB9D0\uC774\uC57C."
    - "\uB9E4\uBC88 \uC790\uB124\uAC00 \uC120\uD0DD\uD55C \uAC70\uB2E4."
    - "\uB2E4\uC2DC \uB3CC\uC544\uC624\uB294 \uAC83\uC744."
    - "\uB05D\uC744 \uBCF4\uB294 \uAC83\uC744."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\u2026\u2026"
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uADF8\uAC8C \uC790\uB124\uC758 \uB9F9\uC138\uC600\uACA0\uC9C0."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uB098\uB3C4 \uADF8\uB7AC\uC5B4."
    - "\uC4F0\uB7EC\uC9C0\uBA74 \uB2E4\uC2DC \uC624\uBA74 \uB41C\uB2E4\uACE0 \uC0DD\uAC01\uD588\uC9C0."
    - "\uC2E4\uC218\uD558\uBA74 \uB2E4\uC74C\uC5D0\uB294 \uB2E4\uB974\uAC8C \uD558\uBA74
      \uB410\uACE0."
    - "\uADF8\uC790\uB97C \uC4F0\uB7EC\uB728\uB9AC\uBA74 \uB3CC\uC544\uAC08 \uC218
      \uC788\uC744 \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD588\uC5B4."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\uADF8\uB7F0\uB370?"
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uC4F0\uB7EC\uB728\uB838\uC9C0."
    - "\uB9C8\uCE68\uB0B4."
    - "\uADF8\uB7F0\uB370 \uC544\uBB34\uAC83\uB3C4 \uB05D\uB098\uC9C0 \uC54A\uC558\uC5B4."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\uC65C?"
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uB05D\uAE4C\uC9C0 \uAC00\uC838\uC628 \uB9F9\uC138\uB294\u2026"
    - "\uB05D\uC5D0 \uB3C4\uB2EC\uD588\uB2E4\uACE0 \uC0AC\uB77C\uC9C0\uB294 \uAC8C
      \uC544\uB2C8\uC5C8\uAC70\uB4E0."
    - "\uB05D\uB0BC \uB300\uC0C1\uC774 \uC0AC\uB77C\uC9C0\uC790."
    - "\uADF8 \uB9F9\uC138\uAC00 \uB05D \uADF8 \uC790\uCCB4\uB97C \uBD99\uB4E4\uC5C8\uC5B4."
    - "\uADF8\uB9AC\uACE0 \uADF8 \uB9F9\uC138\uB97C \uAC00\uC9C4 \uB098\uB3C4 \uD568\uAED8
      \uB0A8\uC558\uC9C0."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\u2026\uADF8\uB798\uC11C \uB2F9\uC2E0\uC774 \uC885\uACB0\uC778\uAC00?"
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uC9C0\uAE08\uC740."
    - "\uC885\uACB0\uC740 \uC0AC\uB78C\uC758 \uC774\uB984\uC774 \uC544\uB2C8\uC57C."
    - "\uD558\uB098\uC758 \uC5ED\uD560\uC77C \uBFD0\uC774\uC9C0."
    - "\uC774\uC57C\uAE30\uC758 \uB05D\uC5D0 \uB3C4\uB2EC\uD588\uC744 \uB54C."
    - "\uADF8 \uB05D\uC5D0 \uB0A8\uB294 \uC790."
    - "\uC6B0\uB9AC\uB294 \uADF8\uAC78 \uC885\uACB0\uC774\uB77C \uBD88\uB800\uB2E4."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\uC7A0\uAE50."
    - "\uB2F9\uC2E0\uB3C4 \uC774\uC804\uC758 \uC885\uACB0\uC744 \uC4F0\uB7EC\uB728\uB838\uB2E4\uACE0
      \uD588\uC9C0."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uADF8\uB798."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uB098"
    lines:
    - "\uADF8\uB9AC\uACE0 \uADF8 \uC21C\uAC04\u2026"
    - "\uB2F9\uC2E0\uC774 \uC774\uACF3\uC5D0 \uB0A8\uAC8C \uB410\uACE0."
    - "\u2026\uADF8\uB7FC \uB0B4\uAC00 \uB2F9\uC2E0\uC744 \uC4F0\uB7EC\uB728\uB9AC\uBA74."
    pauseBefore: 0
    pauseAfter: 0.6
  - speakerName: "\uB098"
    lines:
    - "\uC544\uB2C8."
    - "\uB098\uB294 \uB3CC\uC544\uAC08 \uAC70\uC57C."
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uB098\uB3C4 \uADF8\uB807\uAC8C \uB9D0\uD588\uB2E4."
    pauseBefore: 0
    pauseAfter: 1.5
  - speakerName: "\uB098"
    lines:
    - "\u2026\uADF8\uB7FC \uC774\uAC8C \uC5B4\uB5BB\uAC8C \uB05D\uC774\uB77C\uB294
      \uAC70\uC9C0?"
    pauseBefore: 0
    pauseAfter: 0
  - speakerName: "\uBCF4\uC2A4"
    lines:
    - "\uB05D\uC740 \uBE44\uC5B4 \uC788\uC744 \uC218 \uC5C6\uB098 \uBCF4\uB354\uAD70."
    - "\uB098\uB3C4 \uC624\uB7AB\uB3D9\uC548 \uADF8 \uC774\uC720\uB97C \uC0DD\uAC01\uD588\uC5B4."
    - "\uADF8\uB7EC\uB2E4 \uC54C\uAC8C \uB410\uC9C0."
    - "\uC774\uC57C\uAE30\uB294 \uC2A4\uC2A4\uB85C \uB05D\uB098\uB294 \uAC8C \uC544\uB2C8\uC57C."
